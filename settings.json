{
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "25000",
    "BASH_MAX_OUTPUT_LENGTH": "50000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/.git/objects/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.log)",
      "Read(**/coverage/**)",
      "Read(**/.next/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/credentials*.json)",
      "Read(**/secrets/**)"
    ]
  },
  "effortLevel": "medium"
}
